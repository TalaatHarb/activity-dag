<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="net.talaatharb.activitydag.ui.MainController">
    <top>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
            <Label text="Project:"/>
            <ComboBox fx:id="projectCombo" prefWidth="260"/>
            <Button text="New" onAction="#onNewProject"/>
            <Button text="Rename" onAction="#onRenameProject"/>
            <Button text="Duplicate" onAction="#onDuplicateProject"/>
            <Button text="Delete" onAction="#onDeleteProject"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Activities">
                    <content><fx:include source="activity-tab.fxml"/></content>
                </Tab>
                <Tab text="Graph">
                    <content><fx:include source="graph-tab.fxml"/></content>
                </Tab>
                <Tab text="Kanban">
                    <content><fx:include source="kanban-tab.fxml"/></content>
                </Tab>
                <Tab text="Calendar">
                    <content><fx:include source="calendar-tab.fxml"/></content>
                </Tab>
                <Tab text="Planning">
                    <content><fx:include source="planning-tab.fxml"/></content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
